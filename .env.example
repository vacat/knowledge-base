# ============================================
# 本地运行配置（不推送到 GitHub）
# 复制为 .env 后填入实际 key
# ============================================

# ── LLM Providers ───────────────────────────────────────────────────────────────

# OpenAI（推荐，用于内容分类和摘要）
OPENAI_API_KEY=sk-...

# Anthropic Claude（备选）
ANTHROPIC_API_KEY=sk-ant-...

# 智谱 GLM（国产，便宜）
ZHIPU_API_KEY=...

# Jina Reader（更好的内容提取）
JINA_API_KEY=...

# 指定用哪个 LLM（默认 openai）
# LLM_PROVIDER=zhipu

# ── X / Twitter ────────────────────────────────────────────────────────────────

X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_USER_ID=

# ── GitHub ─────────────────────────────────────────────────────────────────────

GH_PAT=
GH_REPO=your_username/knowledge-base

# ── 日志级别 ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
